# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey)
# Server-only.
GEMINI_API_KEY=

# Mapbox (https://account.mapbox.com/access-tokens/) — powers the
# interactive map, location search/autocomplete, and reverse geocoding.
# Public by design (Mapbox tokens are meant to be used client-side; scope
# it to your URL(s) in the Mapbox dashboard). Leave unset and the app falls
# back gracefully: manual jurisdiction entry, GPS, and everything else
# keeps working, just without the live map/search. See
# docs/MAPBOX_INTEGRATION_REPORT.md.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Reminder scheduler (Phase 4) — server-only. Authorizes calls to
# /api/cron/reminders. Generate any long random string, e.g.:
#   openssl rand -base64 32
# When deployed to Vercel with this same value set as a project env var,
# Vercel Cron (see vercel.json) sends it automatically — no code change
# needed. Without it, the endpoint refuses every request (fails closed).
CRON_SECRET=
